# Copy to .env.local and fill in. Never commit .env.local.
# Supabase (new keys only, never legacy anon/service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
PORTAL_SESSION_SECRET=
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEMO_MODE=

# Seed only (local)
DEMO_MODE=
DEMO_INBOX=
SEED_DEMO_PASSWORD=
